---
import "../styles/global.css";
import site from "../content/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
}

const {
  title = `${site.brand.name} | ${site.brand.tagline}`,
  description = site.brand.description,
  image = "/assets/tcl-hero-lithobreak-legacy.jpg",
  imageAlt = "Tau Ceti Labs science-driven game artwork with a lunar industrial scene.",
  robots
} = Astro.props;

const canonicalPath = Astro.url.pathname === "/" ? "" : Astro.url.pathname.replace(/\/$/, "");
const canonical = `${site.links.canonical.replace(/\/$/, "")}${canonicalPath}`;
const imageUrl = image.startsWith("http") ? image : `${site.links.canonical.replace(/\/$/, "")}${image}`;
const googleAnalyticsEnabled = site.analytics.enabled && site.analytics.provider === "google";
const measurementId = site.analytics.measurementId;
const consentStorageKey = `tauceti:analytics-consent:${site.analytics.domain}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/assets/tau-ceti-labs-logo-icononly.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/tau-ceti-labs-logo-icononly.png" />
    {googleAnalyticsEnabled && (
      <script is:inline define:vars={{ measurementId, consentStorageKey }}>
        (function () {
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
          window.gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied"
          });

          var choice = null;
          try {
            choice = window.localStorage.getItem(consentStorageKey);
          } catch (_error) {
            choice = null;
          }
          if (choice !== "granted" && choice !== "denied") choice = null;

          function loadGoogleAnalytics() {
            if (document.querySelector("script[data-google-analytics]")) return;
            var script = document.createElement("script");
            script.async = true;
            script.dataset.googleAnalytics = "true";
            script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(measurementId);
            document.head.appendChild(script);
            window.gtag("js", new Date());
            window.gtag("config", measurementId);
          }

          window.tauCetiAnalytics = {
            choice: choice,
            update: function (nextChoice) {
              this.choice = nextChoice;
              try {
                window.localStorage.setItem(consentStorageKey, nextChoice);
              } catch (_error) {
                // Consent still applies for the current page if storage is unavailable.
              }
              window.gtag("consent", "update", {
                ad_storage: "denied",
                ad_user_data: "denied",
                ad_personalization: "denied",
                analytics_storage: nextChoice === "granted" ? "granted" : "denied"
              });
              if (nextChoice === "granted") loadGoogleAnalytics();
            },
            reset: function () {
              this.choice = null;
              try {
                window.localStorage.removeItem(consentStorageKey);
              } catch (_error) {
                // The in-memory choice is still cleared.
              }
              window.gtag("consent", "update", {
                ad_storage: "denied",
                ad_user_data: "denied",
                ad_personalization: "denied",
                analytics_storage: "denied"
              });
            }
          };

          if (choice === "granted") {
            window.tauCetiAnalytics.update("granted");
          }
        })();
      </script>
    )}
  </head>
  <body>
    <slot />
    {googleAnalyticsEnabled && (
      <aside class="analytics-consent" data-analytics-consent hidden aria-label="Analytics preferences">
        <p><strong>Optional analytics</strong> Help Tau Ceti Labs understand which projects and links are useful. Google Analytics loads only if you allow it; advertising storage stays off.</p>
        <div class="analytics-consent-actions">
          <button type="button" data-analytics-choice="granted">Allow analytics</button>
          <button type="button" data-analytics-choice="denied">Not now</button>
          <a href="/privacy/">Privacy and choices</a>
        </div>
      </aside>
    )}
    <script is:inline>
      function sanitizeAnalyticsProps(props) {
        var safe = {};
        Object.keys(props || {}).forEach(function (key) {
          var value = props[key];
          if (key === "href") {
            try {
              var url = new URL(String(value), window.location.origin);
              safe.link_domain = url.hostname;
              safe.link_path = url.origin === window.location.origin ? url.pathname : "";
            } catch (_error) {
              // Ignore malformed destinations instead of sending raw URLs.
            }
            return;
          }
          var safeKey = key.replace(/[A-Z]/g, function (letter) { return "_" + letter.toLowerCase(); });
          safe[safeKey] = String(value).slice(0, 100);
        });
        return safe;
      }

      window.tauCetiTrack = function tauCetiTrack(eventName, props) {
        if (!eventName) return;
        window.dispatchEvent(new CustomEvent("tauceti:event", { detail: { eventName, props: props || {} } }));
        if (window.tauCetiAnalytics && window.tauCetiAnalytics.choice === "granted" && typeof window.gtag === "function") {
          window.gtag("event", eventName, sanitizeAnalyticsProps(props));
        }
      };

      var analyticsConsent = document.querySelector("[data-analytics-consent]");
      if (analyticsConsent && window.tauCetiAnalytics && !window.tauCetiAnalytics.choice) {
        analyticsConsent.hidden = false;
      }

      document.addEventListener("click", function (event) {
        var choiceButton = event.target.closest("[data-analytics-choice]");
        if (!choiceButton || !window.tauCetiAnalytics) return;
        window.tauCetiAnalytics.update(choiceButton.getAttribute("data-analytics-choice"));
        if (analyticsConsent) analyticsConsent.hidden = true;
      });

      document.addEventListener("click", function (event) {
        var resetButton = event.target.closest("[data-analytics-reset]");
        if (!resetButton || !window.tauCetiAnalytics) return;
        window.tauCetiAnalytics.reset();
        window.location.reload();
      });

      document.addEventListener("click", function (event) {
        var target = event.target.closest("[data-event]");
        if (!target) return;
        window.tauCetiTrack(target.getAttribute("data-event"), {
          href: target.getAttribute("href") || "",
          label: target.textContent.trim()
        });
      });

      document.addEventListener("submit", async function (event) {
        var form = event.target.closest("[data-subscribe-form]");
        if (!form) return;

        event.preventDefault();

        var status = form.querySelector("[data-subscribe-status]");
        var submit = form.querySelector("button[type='submit']");
        var formData = new FormData(form);
        var payload = {
          email: String(formData.get("email") || ""),
          name: String(formData.get("name") || ""),
          interest: String(formData.get("interest") || ""),
          consentTauCetiUpdates: formData.get("consentTauCetiUpdates") === "true",
          website: String(formData.get("website") || "")
        };

        if (status) {
          status.textContent = "Sending...";
          status.dataset.state = "pending";
        }
        if (submit) submit.disabled = true;

        try {
          var response = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          var result = await response.json().catch(function () {
            return {};
          });

          if (!response.ok) {
            throw new Error(result.message || "Signup could not be saved right now.");
          }

          if (status) {
            status.textContent = "Thanks. You are on the Tau Ceti Labs update list.";
            status.dataset.state = "success";
          }
          form.reset();
          var consent = form.querySelector("input[name='consentTauCetiUpdates']");
          if (consent) consent.checked = true;
          window.tauCetiTrack("submit_subscribe", {
            interest: payload.interest || "unspecified"
          });
        } catch (error) {
          if (status) {
            status.textContent = error.message || "Signup could not be saved right now.";
            status.dataset.state = "error";
          }
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    </script>
  </body>
</html>
